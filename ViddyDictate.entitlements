<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Recording the dictation hotkey's audio. Paired with NSMicrophoneUsageDescription in
	     Info.plist; the entitlement is what the hardened runtime checks, the usage string is what
	     the user is shown. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
